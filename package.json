{
  "name": "brawl-stars-node",
  "version": "3.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "description": "API wrapper for the official Brawl Stars API.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:coverage": "npm run test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run check",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Knightplayzz/brawl-stars-node.git"
  },
  "homepage": "https://github.com/Knightplayzz/brawl-stars-node#readme",
  "bugs": {
    "url": "https://github.com/Knightplayzz/brawl-stars-node/issues"
  },
  "keywords": [
    "brawlstars",
    "brawl",
    "brawlstars-api",
    "API",
    "Supercell"
  ],
  "author": "Philippe Smeets",
  "license": "CC BY-NC",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
